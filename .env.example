# Phase 1 — Supabase foundation for No Type
#
# Copy to .env.local and fill with your project keys from:
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (scripts). Never prefix with VITE_ — do not expose in the browser.
# Used by: node scripts/seed-artists.mjs
# SUPABASE_SERVICE_ROLE_KEY=

# Booking request emails (Vercel /api/booking-request + Vite middleware)
# Prefer Resend in production. Without it, FormSubmit is used as fallback.
# RESEND_API_KEY=
# BOOKING_FROM_EMAIL=No Type Booking <bookings@your-verified-domain.com>
